{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "created_at", "updated_at", "status",
               "provenance", "statement", "citations"],
  "properties": {
    "id": {"type": "string", "pattern": "^F-[0-9]{3,}$"},
    "type": {"const": "fact"},
    "created_at": {"type": "string", "format": "date-time",
                   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "updated_at": {"type": "string", "format": "date-time",
                   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "status": {"enum": ["active", "quarantined"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "agent"],
      "properties": {
        "task": {"type": ["string", "null"], "pattern": "^T-[0-9]{3,}$"},
        "agent": {"type": ["string", "null"]}
      }
    },
    "statement": {"type": "string", "minLength": 1},
    "citations": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^C-[0-9]{3,}$"}
    }
  }
}
