{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "question", "created_at", "scope", "config",
               "models", "preflight", "signals", "status"],
  "properties": {
    "version": {"const": 1},
    "question": {"type": "string", "minLength": 1},
    "created_at": {"type": "string",
                   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope", "success_criteria"],
      "properties": {
        "in_scope": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "success_criteria": {"type": "array", "items": {"type": "string"}}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_depth", "max_parallel", "promotion_threshold",
                   "required_domains", "min_citations", "saturation_window",
                   "saturation_branches", "max_attempts", "fetch_timeout",
                   "agent_timeout"],
      "properties": {
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 12,
                      "description": "Decomposition depth cap. Spec section 2 defaults it to 4."},
        "max_parallel": {"type": "integer", "minimum": 1, "maximum": 32,
                         "description": "Frontier width per tick. Spec section 4 defaults it to 6."},
        "promotion_threshold": {"type": "number", "exclusiveMinimum": 0,
                                "maximum": 1},
        "required_domains": {"type": "integer", "minimum": 1,
                             "description": "Distinct eTLD+1 domains needed for promotion. confidence.compute divides by this, so minimum 1 is not cosmetic."},
        "min_citations": {"type": "integer", "minimum": 1,
                          "description": "Verified citations needed for promotion. Gate 3."},
        "saturation_window": {"type": "integer", "minimum": 1,
                              "description": "Completed tasks the saturation predicate looks back over."},
        "saturation_branches": {"type": "integer", "minimum": 1,
                                "description": "Distinct root branches that window must span before saturation may fire."},
        "max_attempts": {"type": "integer", "minimum": 1,
                         "description": "Rejections before a task is abandoned. Spec section 4 defaults it to 3."},
        "fetch_timeout": {"type": "number", "exclusiveMinimum": 0,
                          "description": "Seconds. Unused: gate 2 is now the rechecker subagent's WebFetch call, which this value does not bound. Kept for schema/config compatibility."},
        "agent_timeout": {"type": "number", "exclusiveMinimum": 0,
                          "description": "Seconds, printed in the step packet. Enforced by absence: submit requeues a dispatched task with no artifact."}
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decomposer", "searcher", "extractor", "rechecker",
                   "hypothesizer", "verifier", "outliner", "synthesizer"],
      "properties": {
        "decomposer": {"type": "string", "minLength": 1},
        "searcher": {"type": "string", "minLength": 1},
        "extractor": {"type": "string", "minLength": 1},
        "rechecker": {"type": "string", "minLength": 1},
        "hypothesizer": {"type": "string", "minLength": 1},
        "verifier": {"type": "string", "minLength": 1},
        "outliner": {"type": "string", "minLength": 1},
        "synthesizer": {"type": "string", "minLength": 1}
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uv", "tectonic"],
      "properties": {
        "uv": {"enum": ["present", "missing"]},
        "tectonic": {"enum": ["present", "missing"]}
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_requested", "stop_when", "checkpoints"],
      "properties": {
        "stop_requested": {"type": "boolean"},
        "stop_when": {
          "type": ["object", "null"],
          "description": "A stop predicate. Validated against schemas/stop_predicate.json separately, not by $ref: cross-file $ref needs a jsonschema registry, and predicates.validate is already the one place that checks this shape."
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["note", "raised_at_tick", "resolved"],
            "properties": {
              "note": {"type": "string", "minLength": 1},
              "raised_at_tick": {"type": "integer", "minimum": 0},
              "resolved": {"type": "boolean"}
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "tick", "halted"],
      "properties": {
        "phase": {"enum": ["init", "scope", "decompose", "research",
                           "synthesize", "render", "done"]},
        "tick": {"type": "integer", "minimum": 0},
        "halted": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["reason", "at_tick", "at", "detail"],
          "properties": {
            "reason": {"enum": ["signal", "coverage", "saturation"]},
            "at_tick": {"type": "integer", "minimum": 0},
            "at": {"type": "string",
                   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
            "detail": {"type": "string"}
          }
        }
      }
    }
  }
}
